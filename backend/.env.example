# Copiar a backend/.env y completar localmente. No versionar credenciales reales.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
DB_NAME=postgres
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=your-postgresql-host
DB_PORT=5432
ORDER_DEMO_ENABLED=True
PRODUCTION_DEMO_ENABLED=True

# Checkout Culqi de integración. Activar tras validar las credenciales de prueba.
PAYMENTS_ENABLED=False
PAYMENTS_ENVIRONMENT=test
PAYMENT_RESERVATION_MINUTES=10
# Nunca usar una llave secreta VITE_*. Este circuito rechaza las llaves live.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
